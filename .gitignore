*.iml
.gradle
/local.properties
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/.idea/

# ROADMAP Task 15 Phase B2b: CHANGELOG.md is copied into the app's assets at build time so the
# in-app "What's new" viewer can read it. The copy is a build artifact -- the root CHANGELOG.md
# stays the single source of truth, and ignoring the copy is what makes it impossible to commit a
# stale duplicate of it.
/app/src/main/assets/CHANGELOG.md

# Build-time copies of docs/sample-data/*.csv, used by the instrumented seeding test. Same reasoning
# as the changelog copy above: docs/sample-data stays the single source of truth.
/app/src/androidTest/assets/

# Credential file types, ignored so they cannot be committed by an over-broad `git add`. This is
# leak prevention only -- it configures nothing and presumes nothing about how signing will work.
# It is here because gitleaks cannot cover these: a keystore is opaque binary with no pattern to
# match, so not committing it is the only defence available.
*.jks
*.keystore
*.p12
keystore.properties

# Scratch output from the Gemini coding tool (one opaque UUID-named directory per session). Local
# working state, not project state -- nothing in the build, the app or the docs reads it. Ignored
# rather than merely left untracked so it cannot ride along on an over-broad `git add`, which is
# what would otherwise happen eventually given it reappears on every session.
/.artifacts/
