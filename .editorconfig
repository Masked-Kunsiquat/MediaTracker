[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 4
insert_final_newline = true

# 120 is the Kotlin/IntelliJ default, and it is what this codebase was already written to -- its
# explanatory KDoc runs to roughly 110 columns throughout. The 100 this file originally carried was
# an arbitrary pick, and enforcing it would have meant reflowing hundreds of comment blocks that
# were deliberately laid out, plus suppressing SQL string literals in the migration tests that
# cannot be broken at all. The limit moved to the code rather than the other way round.
max_line_length = 120

ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Compose names @Composable functions in PascalCase by convention, which the standard Kotlin
# function-naming rule rejects (119 hits, all of them Composables). Scoped to the annotation rather
# than disabling the rule outright, so ordinary functions are still held to camelCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Several files pair a KDoc block with a trailing EOL comment qualifying one specific line of it.
# That is a deliberate habit here, and the rule cannot tell it apart from a stray double comment.
ktlint_standard_no-consecutive-comments = disabled

# Files are named for what they hold rather than for the single class inside them: NavRoutes.kt,
# ViewModelTestSupport.kt, InlineMarkup.kt. Satisfying the rule would rename those to Route.kt,
# ViewModelRegistry.kt and InlineSpan.kt, each of which describes the file's contents less well
# than the name it has.
ktlint_standard_filename = disabled

# Code style is left at ktlint's default `ktlint_official`. `intellij_idea` was measured as the
# alternative and is a far worse fit here -- the tree is already formatted to ktlint_official, so
# switching reports 2285 violations against 45.
